#!/usr/bin/env bash
# voice-hub wrapper — TTS + Bilibili cover gateway for the IM plugin.
# Runtime directory defaults to ~/feiyu-voice-lite; override with SONG2CUTE_HOME.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${SONG2CUTE_HOME:-$HOME/feiyu-voice-lite}"
exec "$ROOT/.venv/bin/python" "$HERE/voice_hub.py" "$@"
