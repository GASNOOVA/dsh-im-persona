{
  "name": "dsh-im-persona",
  "version": "5.10.0-personal.3",
  "icon": "./assets/logo-plugin-message-link-gradient.webp",
  "description": "个人定制版 IM 机器人：把微信与 QQ 接入 DeepSeek Harness，支持为每个机器人配置角色人设（基于 @xmanrui/dsh-im 5.10.0 独立改造）。Personal-edition IM bot for DSH: WeChat and QQ only, with per-bot persona.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-im-persona",
    "im",
    "wechat",
    "qq",
    "persona",
    "chatbot",
    "ai-agent",
    "personal-edition"
  ],
  "author": "Cheng Chen",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GASNOOVA/dsh-im-persona.git"
  },
  "homepage": "https://github.com/GASNOOVA/dsh-im-persona#readme",
  "bugs": {
    "url": "https://github.com/GASNOOVA/dsh-im-persona/issues"
  },
  "bin": {
    "dsh-im-persona": "bin/dsh-im-persona.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "plugin-src",
    "src",
    "scripts",
    "docs",
    "PROACTIVE_DELIVERY.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/*/*.test.mjs",
    "verify:trim": "node scripts/verify-channel-trim.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22.19"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "qrcode": "1.5.4",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  }
}
